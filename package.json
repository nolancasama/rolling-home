{
  "name": "rolling-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rolling Home - a stylized 3D RV life simulation (TypeScript + Three.js).",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "vite-node tools/balance-report.ts",
    "acceptance": "node acceptance/run.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
